    "configuration": {
      "title": "Ugarit",
      "properties": {
        "Ugarit.phpEnvironment": {
          "type": "string",
          "enum": [
            "auto",
            "herd",
            "valet",
            "sail",
            "lando",
            "ddev",
            "local",
            "docker"
          ],
          "enumItemLabels": [
            "Auto Detect",
            "Herd",
            "Valet",
            "Sail",
            "Lando",
            "DDEV",
            "Local",
            "Docker"
          ],
          "markdownEnumDescriptions": [
            "Auto detect the local PHP environment.",
            "Auto detect PHP version Herd is using for the project.",
            "Auto detect PHP version Valet is using for the project.",
            "Sail",
            "Lando",
            "DDEV",
            "Use PHP installed on the local machine.",
            "Docker"
          ],
          "default": "auto",
          "markdownDescription": "Local PHP environment used for path handling in environments such as Sail, Lando, DDEV, and Docker. PHP execution uses `#Ugarit.phpCommand#`."
        },
        "Ugarit.phpCommand": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "PHP command used by the Ugarit LSP server, Docker environment configuration, Scribe commands, Pint, and test runner, in argv format. Defaults to php when empty."
        },
        "Ugarit.memoryLimit": {
          "type": "string",
          "default": "512M",
          "markdownDescription": "Memory limit for the Ugarit LSP server process. Use PHP shorthand such as `512M`, `1G`, or `-1`. This does not change `#Ugarit.phpCommand#`."
        },
        "ugaritLsp.trace.server": {
          "scope": "window",
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the Ugarit LSP server."
        },
        "Ugarit.basePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "_Relative_ base path for the Ugarit project. This is used to resolve paths in the project. e.g. src, code/backend\n\n_Requires extension reload after changing._"
        },
        "Ugarit.showErrorPopups": {
          "type": "boolean",
          "default": false,
          "description": "Show popups for errors."
        },
